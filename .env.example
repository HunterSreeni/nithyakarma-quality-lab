BASE_URL=https://baseurl.com
E2E_EMAIL=your-test-account-email
E2E_PASSWORD=your-test-account-password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# admin key, used only to mint a magic-link session for the test account. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# optional: set to 1 to run the two tests that write data with no cleanup yet
E2E_ALLOW_DATA_WRITES=0
